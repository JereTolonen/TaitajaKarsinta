<%# AI-KÄYTTÖ ALKAA | Työkalu: Claude (Anthropic) | Tarkoitus: tapahtuman yksityiskohtasivun rakenne wireframen mukaan sekä rakenteen refaktorointi %>
<!DOCTYPE html>
<html lang="fi">
<head>
  <%- include('partials/head') %>
  <script src="/javascripts/suosikit.js" defer></script>
  <script src="/javascripts/tapahtuma.js" defer></script>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="container detail">
    <a class="back-link" href="/#tapahtumat"><span aria-hidden="true">←</span> Takaisin tapahtumiin</a>

    <p id="tapahtuman-tila" class="list-status" role="alert" hidden></p>

    <article class="detail-card" id="tapahtuma" hidden>
      <div class="detail-media">
        <img id="tapahtuma-kuva" src="" alt="" width="768" height="512">
      </div>

      <div class="detail-content">
        <h1 id="tapahtuma-nimi"></h1>

        <div class="detail-meta">
          <span class="tag" id="tapahtuma-kategoria"></span>
          <p class="meta"><img src="/icons/location.svg" alt="Paikkakunta" width="16" height="16"><span id="tapahtuma-paikkakunta"></span></p>
          <p class="meta"><img src="/icons/people.svg" alt="Osallistujat" width="16" height="16"><span id="tapahtuma-osallistujat-teksti"></span></p>
        </div>

        <p class="detail-description" id="tapahtuma-tiedot"></p>

        <dl class="info-list">
          <div class="info-item">
            <dt><img src="/icons/location.svg" alt="" width="32" height="32">Paikkakunta</dt>
            <dd id="tapahtuma-paikkakunta-tieto"></dd>
          </div>
          <div class="info-item">
            <dt><img src="/icons/users.svg" alt="" width="32" height="32">Osallistujia</dt>
            <dd id="tapahtuma-osallistujat"></dd>
          </div>
        </dl>

        <div class="detail-actions">
          <button class="fav-btn" type="button" aria-pressed="false">
            <img src="/icons/heart-outline.svg" alt="" width="22" height="22">
            <span class="fav-text">Lisää suosikiksi</span>
          </button>
        </div>
      </div>
    </article>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
<%# AI-KÄYTTÖ PÄÄTTYY %>
